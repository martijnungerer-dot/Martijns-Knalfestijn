// Cloudflare-configuratie. Deploy: `npm run deploy` (of koppel de repository in Cloudflare → Workers Builds).
{
  "name": "martijns-knalfestijn",
  "main": "apps/worker/worker.mjs",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "apps/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "SessionObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionObject"] }]
}
